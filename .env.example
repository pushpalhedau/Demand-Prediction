# Copy to .env for local development. NEVER commit .env (it is git-ignored).
# In production, provide these through your platform's secret store, not a file.

# development | production. In production the app refuses to start with any development default below.
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Database (hosted Supabase Postgres) ─────────────────────────────────────────
# The app connects as a restricted role (row-level security enforced). The owner role is used only for schema
# changes, tenant provisioning and the audit trail. They MUST be different roles. Use the SESSION pooler
# connection string from your project's "Connect" dialog (port 5432), not the transaction pooler.
DATABASE_URL=postgresql+psycopg2://predictax_app.<project-ref>:<app-role-password>@<pooler-host>:5432/postgres
ADMIN_DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<postgres-password>@<pooler-host>:5432/postgres

# ── Authentication (hosted Supabase Auth) ──────────────────────────────────────
AUTH_BASE_URL=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Signs and verifies login tokens (HS256 projects only -- newer ES256 projects verify via the project's JWKS
# instead) and, derived, signs saved model files. At least 32 random characters. Get it from the project's
# Project Settings -> JWT Keys -> Legacy JWT Secret.
SUPABASE_JWT_SECRET=

# ── Background jobs ────────────────────────────────────────────────────────────
# Leave REDIS_URL unset to run imports in a background thread (fine for development).
# REDIS_URL=redis://:password@localhost:6379/0
# REDIS_PASSWORD=

# ── Files ──────────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MODEL_DIR=models
MAX_UPLOAD_MB=500

# ── Optional paid sentiment scoring (OFF by default: the free offline scorer is used) ──
# XAI_API_KEY=
# ALLOW_PAID_SENTIMENT=1
