# App connects as a restricted role (RLS enforced). Owner URL is for migrations/provisioning only.
DATABASE_URL=postgresql+psycopg2://predictax_app:predictax_app_dev@localhost:5432/predictax
ADMIN_DATABASE_URL=postgresql+psycopg2://predictax_owner:predictax_owner_dev@localhost:5432/predictax
UPLOAD_DIR=./data/uploads

# Supabase project (Auth only). JWT secret: Project Settings > API > JWT Secret.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

XAI_API_KEY=
SERPER_API_KEY=

# Free local auth server (docker compose up auth). For hosted Supabase, unset AUTH_BASE_URL
# and set SUPABASE_URL + SUPABASE_ANON_KEY instead.
AUTH_BASE_URL=http://localhost:9999
SUPABASE_JWT_SECRET=predictax-dev-jwt-secret-change-me-0123456789abcdef
