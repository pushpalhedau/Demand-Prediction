# ── Required secrets ────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Groq LLM API key — required for AI executive briefings and AI Studio
# Get a free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# NewsAPI.org key — required for What-If lever calibration (free tier: 100 req/day)
# Get a free key at: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# ── Optional — override only if your deployment differs from defaults ────────

# Absolute path to the datasets folder (useful for Docker volume mounts)
# Default: auto-detected relative to the project root
# DATA_LAKE_DIR=/data/UAE_REAL_ESTATE_DATA_LAKE/datasets

# Backend FastAPI service URL (used by Streamlit frontend)
# BACKEND_URL=http://localhost:8000
# BACKEND_PORT=8000

# Streamlit frontend port
# STREAMLIT_PORT=8501

# SQLAlchemy DB URL
# DATABASE_URL=sqlite:///./uae_platform.db

# Deployment environment — controls logging verbosity
# ENVIRONMENT=development   # development | staging | production
# DEBUG=true
