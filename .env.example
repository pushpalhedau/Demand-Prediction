# Copy to .env for local development. NEVER commit .env (it is git-ignored).
# In production, provide these through your platform's secret store, not a file.

# development | production. In production the app refuses to start with any development default below.
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Database ───────────────────────────────────────────────────────────────────
# The app connects as a restricted role (row-level security enforced). The owner role is used only for schema
# changes, tenant provisioning and the audit trail. They MUST be different roles.
DATABASE_URL=postgresql+psycopg2://predictax_app:predictax_app_dev@localhost:5432/predictax
ADMIN_DATABASE_URL=postgresql+psycopg2://predictax_owner:predictax_owner_dev@localhost:5432/predictax
# Passwords the database container sets on first start (docker-compose reads these too).
# APP_DB_PASSWORD=
# OWNER_DB_PASSWORD=
# AUTH_DB_PASSWORD=

# ── Authentication (open-source Supabase Auth / GoTrue) ───────────────────────
# Self-hosted (docker compose up auth):
AUTH_BASE_URL=http://localhost:9999
# Hosted Supabase instead: unset AUTH_BASE_URL and set SUPABASE_URL + SUPABASE_ANON_KEY (+ SUPABASE_SERVICE_ROLE_KEY).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Signs and verifies login tokens (and, derived, model files). At least 32 random characters in production.
SUPABASE_JWT_SECRET=predictax-dev-jwt-secret-change-me-0123456789abcdef

# ── Background jobs ────────────────────────────────────────────────────────────
# Leave REDIS_URL unset to run imports in a background thread (fine for development).
# REDIS_URL=redis://:password@localhost:6379/0
# REDIS_PASSWORD=

# ── Files ──────────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MODEL_DIR=models
MAX_UPLOAD_MB=500

# ── Optional paid sentiment scoring (OFF by default: the free offline scorer is used) ──
# XAI_API_KEY=
# ALLOW_PAID_SENTIMENT=1
